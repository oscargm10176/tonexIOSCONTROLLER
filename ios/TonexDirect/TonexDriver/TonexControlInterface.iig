//
//  TonexControlInterface.iig
//  Se engancha a la interfaz CDC de control ("ToneX Control VCOM", interfaz 0) y hace lo
//  mismo que el ESP32 al abrir el puerto: line coding 115200 8N1 y DTR/RTS activos.
//

#ifndef TonexControlInterface_h
#define TonexControlInterface_h

#include <Availability.h>
#include <DriverKit/IOService.iig>

class TonexControlInterface: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
};

#endif /* TonexControlInterface_h */
