      }
    },
    "Conecta el pedal de expresión al BlueBoard, toca “Aprender” y muévelo de punta a punta. Si sube al revés, activa “Invertir”." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug the expression pedal into the BlueBoard, tap “Learn” and move it from heel to toe. If it goes the wrong way, turn on “Invert”."
          }
        }
      }
    },
    "Conecta el pedal por USB para editar los efectos." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect the pedal via USB to edit the effects."
